# Jail template — setup-firewall.sh writes the real file with absolute log paths.
# Ban AUTH abusers; ignore whitelist from exim-docker-ignore.local

[exim-docker-auth]
enabled = true
filter = exim-docker-auth
backend = auto
maxretry = 5
findtime = 10m
bantime = 12h
action = docker-user[name=exim-docker-auth]
# logpath filled by setup-firewall.sh
